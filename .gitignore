# Build targets and packaging
/target
/dist/
/build/
/DerivedData/
/output/
*.log

# SwiftPM, Xcode, and macOS App artifacts
/macos/**/.build/
/macos/**/.swiftpm/
/macos/**/xcuserdata/
/macos/**/*.xcuserstate
/macos/**/*.dmg
/macos/**/*.app
/macos/**/*.zip

# Android and Gradle artifacts
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/**/*.apk
/android/**/*.aab
.gradle/
captures/

# Python and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# IDE, Editor, and Tooling metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
**/.DS_Store
.Spotlight-V100
.Trashes

# Development agent and test metadata
.zcode/
.agent/
.gemini/
.antigravity/
.playwright-cli/

# macOS diagnostics (generated on host, contains machine names/timestamps)
/diagnostics/*.txt
/diagnostics/*.json

